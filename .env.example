# ==============================================================================
# CogniCode - Environment Configuration
# ==============================================================================

# Google AI Studio API Key (Required for live Gemma 4 mentor responses)
# Generate your official API key at: https://aistudio.google.com/api-keys
# 
# 1. Copy this file to .env:
#    cp .env.example .env
# 2. Paste your real API key below:
GEMINI_API_KEY=

# Model configuration for Google AI Studio (Default: gemma-4-26b-a4b-it)
# Supported Google AI Studio Gemma models include:
# - gemma-4-26b-a4b-it (Gemma 4 Mixture-of-Experts)
# - gemma-4-31b-it     (Gemma 4 Dense)
# - gemma-2-27b-it     (Gemma 2 27B)
# - gemma-2-9b-it      (Gemma 2 9B)
GEMMA_MODEL_ID=gemma-4-26b-a4b-it
